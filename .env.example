# Server
PORT=3040
DRAIN_TIMEOUT=300
SHUO_VERBOSE_EVENTS=0
SHUO_LOG_INTERIM=0

# Twilio (Voice)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
# an ngrok public URL can be used as well which can be configured at https://dashboard.ngrok.com/domains
TWILIO_PUBLIC_URL=https://your-public-url.example.com
TWILIO_REGION=us1
TWILIO_EDGE=ashburn

# Speech-to-Text (Deepgram Flux)
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_REGION=us
DEEPGRAM_MODEL=flux-general-en
DEEPGRAM_LANGUAGE=en

# LLM
GROQ_API_KEY=your_groq_api_key
LLM_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_openai_api_key

# Text-to-Speech (ElevenLabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# LiveKit (telephony experiment)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_PHONE_NUMBER=+15551234567
LIVEKIT_DEEPGRAM_MODEL=nova-3
LIVEKIT_DEEPGRAM_LANGUAGE=pt-BR
LIVEKIT_LLM_MODEL=llama-3.3-70b-versatile
LIVEKIT_ELEVENLABS_VOICE_ID=G7ILShrCNLfmS0A37SXS
LIVEKIT_ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# only needed for outbound PSTN calls
SIP_OUTBOUND_TRUNK_ID=ST_your_livekit_outbound_trunk_id
